# ==============================================================
# CorpVPN acceptance kit - settings for tools/acceptance/run.sh
# ==============================================================
# cp tools/acceptance/acceptance.env.example tools/acceptance/acceptance.env
# Read by bash: quote values that contain spaces. See README.md next to it.

# --------------------------------------------------------------
# The VMs: fresh Debian 12 / 13 or Ubuntu 22.04 / 24.04, any provider,
# all from the same image.
# --------------------------------------------------------------
# Gateway (server A): gets the product through quickstart.sh, plus the lab
# Keycloak. A public address this machine can reach.
GATEWAY_HOST=203.0.113.10                # REQUIRED
# Connector (server B): split mode, the simulated office LAN and the lab
# Active Directory. Without it the ldap and policy stages are skipped.
CONNECTOR_HOST=198.51.100.20
# Optional third VM for the VPN clients; empty = the connector.
CLIENT_HOST=

# SSH from this machine to every VM: as root, or as a user with passwordless sudo.
SSH_KEY=~/.ssh/id_ed25519                # REQUIRED
SSH_USER=root

# --------------------------------------------------------------
# What to install and check
# --------------------------------------------------------------
# Git revision of this checkout to install (branch, tag or commit), or
# "worktree": the checkout itself with uncommitted changes to tracked files.
SOURCE_REF=HEAD
PROTOCOLS=wg,awg,vless
# The simulated office LAN behind the connector; also the installer's CORP_CIDRS.
OFFICE_CIDR=172.30.0.0/24
# Any other quickstart.env setting: QUICKSTART_<NAME>=value is written as <NAME>=value.
#QUICKSTART_XRAY_VERSION=v25.9.11
#QUICKSTART_REALITY_SERVER_NAME=www.cloudflare.com
#QUICKSTART_PANEL_FQDN=vpn.corp.example
#QUICKSTART_CERTBOT_EMAIL=it@corp.example

# --------------------------------------------------------------
# Lab identity providers (Docker images; pin a digest for repeatable runs)
# --------------------------------------------------------------
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:09a381c715ab0b111835b70f2905955274843a219c6f27efb348e4d9f4086858
KEYCLOAK_PORT=8081
SAMBA_IMAGE=nowsci/samba-domain@sha256:953f973514f19f236b0eb838b0e8c98c274b44f70c2bf7f817a0aa931e8f3eb9

# --------------------------------------------------------------
# The kit itself
# --------------------------------------------------------------
# Everything a run produces, secrets included (mode 700).
# Empty = ~/.cache/corpvpn-acceptance/<GATEWAY_HOST>
WORK_DIR=
# Answers with the caller's public address ("ip=..." lines or the bare address).
# Must name an IPv4 address: the client's test namespace has no DNS.
EGRESS_URL=https://1.1.1.1/cdn-cgi/trace
