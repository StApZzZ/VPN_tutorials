# Local development: copy to panel/.env, set PANEL_SECRET_TOKEN, then run from
# panel/:  python -m uvicorn main:app --reload
# No root, WireGuard, Xray or nftables needed: those parts report "not
# configured". On a server this file is rendered by
# deploy/ansible/roles/app/templates/env.j2 instead. Every setting is documented
# in config.py.

# Break-glass admin: user "admin" with this token as the password, and the API
# Bearer token. Use a long random value, e.g. `openssl rand -base64 32`.
PANEL_SECRET_TOKEN=replace-with-long-random-token
PANEL_USERNAME=admin
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
PANEL_PUBLIC_URL=http://127.0.0.1:8080
# Interactive API docs at /docs (always off on servers).
API_DOCS_ENABLED=true

# Databases and state files: any writable directory outside the repository.
CORPVPN_STATE_DIR=${HOME}/.local/state/corpvpn-dev
# Users, sessions and the audit log.
CORPVPN_DB_PATH=${HOME}/.local/state/corpvpn-dev/corpvpn.db
BACKUP_DIR=${HOME}/.local/state/corpvpn-dev/backups

# Nothing is loaded into the kernel. Servers run "enforce".
NETWORK_POLICY_MODE=off

# Gateway address employees' clients dial (DNS name or IP).
SERVER_PUBLIC_IP=203.0.113.10
SERVER_PUBLIC_HOST=vpn.example.com

# WireGuard (wg0) and AmneziaWG (awg0): the pools must be the same size.
# Production state lives in /etc/wireguard and /etc/amnezia/amneziawg;
# both directories are private to root.
WG_CONFIG_PATH=${HOME}/.local/state/corpvpn-dev/wg0.conf
WG_PUBLIC_KEY_PATH=${HOME}/.local/state/corpvpn-dev/wg0_public.key
WG_CLIENTS_TABLE=${HOME}/.local/state/corpvpn-dev/clientsTable
CLIENT_PRIVATE_KEYS_PATH=${HOME}/.local/state/corpvpn-dev/clientsPrivateKeys.json
WG_PORT=51820
WG_NETWORK=10.66.0.0/22
AWG_NETWORK=10.66.4.0/22
AWG_INTERFACE=awg0
# Match the mirror configuration. Server deployment renders the actual path,
# normally /etc/amnezia/amneziawg/awg0.conf.
AWG_CONFIG_PATH=${HOME}/.local/state/corpvpn-dev/awg0.conf
AWG_SERVER_PUBLIC_KEY=
# Resolver handed to clients, normally the corporate internal DNS.
DNS_SERVERS=10.0.0.53

# Per-peer traffic metrics are personal data; off by default.
METRICS_PEER_DETAIL=false

# Xray (VLESS / REALITY). Empty commands: the panel never applies Xray configs.
XRAY_VALIDATE_COMMAND=
XRAY_RELOAD_COMMAND=
XRAY_CLIENT_SERVER=vpn.example.com
XRAY_CLIENT_PORT=443
XRAY_CLIENT_REALITY_SERVER_NAME=www.cloudflare.com
XRAY_CLIENT_REALITY_PUBLIC_KEY=
XRAY_CLIENT_REALITY_SHORT_ID=

# Local employee accounts: one-use 72-hour invitation / reset, scrypt and TOTP.
LOCAL_ACCOUNTS_ENABLED=true
AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_TOTP=admins
AUTH_LOCAL_ALLOWED_CIDRS=
LOCAL_DATA_KEY_PATH=${HOME}/.local/state/corpvpn-dev/local-data.key
# Identity provider and roles; exact qualified group values are recommended.
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
LDAP_ENABLED=false
LDAP_URL=
LDAP_START_TLS=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
AUTH_ADMIN_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_USER_GROUPS=
# metrics and auditor are read-only API-token scopes, issued in the panel.
AUDIT_RETENTION_DAYS=365
