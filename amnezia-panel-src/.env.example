# Panel auth token. Use a long random value.
PANEL_SECRET_TOKEN=replace-with-long-random-token

# Public/fallback addresses for your deployment.
SERVER_PUBLIC_IP=203.0.113.10
SERVER_FALLBACK_IP=198.51.100.20
SERVER_PUBLIC_HOST=vpn.example.com
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_PUBLIC_KEY_PATH=/etc/wireguard/wg0_public.key
WG_CLIENTS_TABLE=/etc/wireguard/clientsTable
CLIENT_PRIVATE_KEYS_PATH=/etc/wireguard/clientsPrivateKeys.json
AWG_SETTINGS_PATH=/etc/vpn-panel/awg_settings.json
WG_PORT=34011
WG_ENDPOINT_HOST=vpn.example.com
WG_NETWORK=10.8.2.0/24
WG_SERVER_IP=10.8.2.1

# DNS for generated client configs
DNS_SERVERS=1.1.1.1,1.0.0.1

# Panel bind address
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# Telegram bot. Keep real tokens and IDs out of git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_vpn_bot
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ACCESS_PATH=/etc/vpn-panel/telegram_access.json
TELEGRAM_COMMAND_DOCS_PATH=/etc/vpn-panel/telegram_command_docs.conf
TELEGRAM_PANEL_BASE_URL=http://127.0.0.1:8080
TELEGRAM_PANEL_TOKEN=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_REQUEST_TIMEOUT=45
TELEGRAM_PROXY_URL=
TELEGRAM_SUBSCRIPTION_CHECK_INTERVAL_SECONDS=300
TELEGRAM_SUBSCRIPTION_NOTIFY_DAYS=3,1,0

# Backups
BACKUP_DIR=/var/backups/vpn-panel

# Routing overrides store
ROUTING_OVERRIDES_PATH=/etc/vpn-panel/routing_overrides.json

# Generated routing / merged config artifacts
XRAY_ROUTING_EXPORT_PATH=/etc/xray/routing.generated.json
XRAY_MERGED_CONFIG_EXPORT_PATH=/etc/xray/config.generated.json
XRAY_BASE_CONFIG_PATH=/etc/xray/config.json
XRAY_ACTION_STATE_PATH=/etc/vpn-panel/xray_action_state.json
XRAY_APPLY_BACKUP_DIR=/var/backups/vpn-panel/xray
XRAY_VALIDATE_COMMAND=
XRAY_RELOAD_COMMAND=

# VLESS/Xray client profiles generated by the panel
XRAY_CLIENTS_PATH=/etc/vpn-panel/xray_clients.json
XRAY_CLIENT_INBOUND_TAG=vless-in
XRAY_CLIENT_SERVER=vpn.example.com
XRAY_CLIENT_PORT=443
XRAY_CLIENT_NETWORK=tcp
XRAY_CLIENT_SECURITY=reality
XRAY_CLIENT_LOCAL_SOCKS_PORT=10808
XRAY_CLIENT_LOCAL_HTTP_PORT=10809
XRAY_CLIENT_REALITY_SERVER_NAME=www.microsoft.com
XRAY_CLIENT_REALITY_PUBLIC_KEY=
XRAY_CLIENT_REALITY_SHORT_ID=
XRAY_CLIENT_FINGERPRINT=chrome
XRAY_CLIENT_FLOW=
