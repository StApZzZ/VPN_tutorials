#!/usr/bin/env python3
"""Validate and restore a CorpVPN backup. Services must be stopped for --apply."""
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import posixpath
import shutil
import sys
import tarfile
import tempfile

PREFIXES = ("etc/wireguard", "etc/amnezia/amneziawg", "etc/xray", "etc/vpn-panel", "etc/letsencrypt")
FILES = ("opt/vpn-panel/.env", "etc/nftables.d/50-corpvpn-policy.nft")


def allowed(name):
    return name in FILES or any(name == p or name.startswith(p + "/") for p in PREFIXES)


def canonical(name):
    if name.startswith("/") or ".." in PurePosixPath(name).parts or "\\" in name:
        raise ValueError("unsafe archive path")
    value = posixpath.normpath(name)
    if value in {".", ""}:
        raise ValueError("empty archive path")
    return value


def check(archive):
    members = archive.getmembers()
    if len(members) > 50000 or sum(m.size for m in members) > 1024**3:
        raise ValueError("backup exceeds restore limits")
    manifest_members = [m for m in members if m.name == "corpvpn-manifest.json"]
    if len(manifest_members) != 1 or not manifest_members[0].isfile() or manifest_members[0].size > 8*1024**2:
        raise ValueError("missing or invalid manifest")
    manifest = json.load(archive.extractfile(manifest_members[0]))
    if manifest.get("format") != 1 or not isinstance(manifest.get("files"), dict):
        raise ValueError("unsupported backup format")
    entries = []; seen = set(); actual = set()
    for member in members:
        if member.name == "corpvpn-manifest.json":
            continue
        name = canonical(member.name)
        if not allowed(name):
            raise ValueError("path is outside CorpVPN restore locations: " + name)
        if name in seen:
            raise ValueError("duplicate archive member: " + name)
        seen.add(name)
        if member.isfile():
            digest = hashlib.sha256()
            stream = archive.extractfile(member)
            for chunk in iter(lambda: stream.read(1048576), b""):
                digest.update(chunk)
            if digest.hexdigest() != manifest["files"].get(name):
                raise ValueError("checksum mismatch: " + name)
            actual.add(name)
        elif member.issym():
            target = member.linkname.lstrip("/") if member.linkname.startswith("/") else posixpath.normpath(posixpath.join(posixpath.dirname(name), member.linkname))
            if not allowed(canonical(target)):
                raise ValueError("symlink escapes restore locations")
        elif not member.isdir():
            raise ValueError("special files and hard links are forbidden")
        entries.append((name, member))
    if actual != set(manifest["files"]):
        raise ValueError("manifest file list differs from archive")
    # No archive member may put a parent under a symlink.
    links = {n for n,m in entries if m.issym()}
    if any(any(str(parent) in links for parent in PurePosixPath(n).parents) for n,m in entries):
        raise ValueError("archive member has symlink parent")
    return manifest, entries


def safe_destination(root, name, allow_leaf_link=False):
    destination = root / name
    for parent in [destination, *destination.parents]:
        if parent == root.parent:
            break
        if parent == destination and allow_leaf_link:
            continue
        if parent.is_symlink():
            raise ValueError("existing symlink at restore path: " + str(parent))
    return destination


def restore(archive_path, root, apply=False):
    root = Path(root).resolve()
    with tarfile.open(archive_path, "r:gz") as archive:
        manifest, entries = check(archive)
        destinations = {n:safe_destination(root,n,m.issym()) for n,m in entries}
        if not apply:
            return manifest
        # Stage all content before replacing any live file.
        with tempfile.TemporaryDirectory(prefix="corpvpn-restore-") as staging:
            staged = Path(staging)
            for name, member in entries:
                if member.isfile():
                    file = staged / name; file.parent.mkdir(parents=True, exist_ok=True)
                    with archive.extractfile(member) as source, file.open("wb") as target:
                        shutil.copyfileobj(source,target)
                    if hashlib.sha256(file.read_bytes()).hexdigest() != manifest["files"][name]:
                        raise ValueError("staged checksum mismatch")
            for name, member in sorted(entries, key=lambda entry: (not entry[1].isdir(),entry[0].count("/"))):
                dest = destinations[name]
                dest.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
                if member.isdir():
                    dest.mkdir(exist_ok=True,mode=member.mode & 0o777)
                elif member.isfile():
                    fd, temporary = tempfile.mkstemp(prefix=".restore-",dir=dest.parent)
                    try:
                        with os.fdopen(fd,"wb") as handle, (staged/name).open("rb") as source:
                            shutil.copyfileobj(source,handle);handle.flush();os.fsync(handle.fileno())
                        os.chmod(temporary,member.mode & 0o777)
                        if os.geteuid() == 0:os.chown(temporary,member.uid,member.gid)
                        os.replace(temporary,dest)
                    finally:
                        if os.path.exists(temporary):os.unlink(temporary)
                else:
                    target = member.linkname.lstrip("/") if member.linkname.startswith("/") else posixpath.normpath(posixpath.join(posixpath.dirname(name),member.linkname))
                    if dest.exists() or dest.is_symlink():dest.unlink()
                    dest.symlink_to(os.path.relpath(root/target,dest.parent))
        return manifest


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--archive",required=True)
    parser.add_argument("--root",default="/")
    parser.add_argument("--apply",action="store_true")
    args=parser.parse_args()
    try:
        manifest=restore(args.archive,args.root,args.apply)
    except (ValueError,OSError,tarfile.TarError) as exc:
        print("restore failed: "+str(exc),file=sys.stderr);return 1
    print(json.dumps({"validated_files":len(manifest["files"]),"applied":args.apply,"public_keys":manifest.get("public_keys",{})}))
    return 0


if __name__=="__main__":sys.exit(main())
