#!/usr/bin/env python3
# {{ ansible_managed }}
"""Mirror the active {{ awg_server_wg_iface }} peers onto {{ awg_server_iface }} (AmneziaWG).

A {{ awg_server_wg_iface }} pool address becomes the {{ awg_server_iface }} pool address with the same host
offset ({{ awg_server_wg_network }} -> {{ awg_server_network }}); other AllowedIPs are copied as
they are. Peers the panel disabled (commented out in {{ awg_server_wg_iface }}.conf) are left out,
so a suspended device loses AmneziaWG access on the next run as well. Applies
live with `awg syncconf` (no restart); `--no-apply` only writes the file.

`--check-obfuscation FILE` compares the running interface with the obfuscation
parameters in FILE and exits 3 when they differ (0 when the interface is down).
"""
import ipaddress
import json
import os
import re
import subprocess
import sys

IFACE = "{{ awg_server_iface }}"
CONF = "{{ awg_server_conf_dir }}/{{ awg_server_iface }}.conf"
IFACE_SRC = "{{ awg_server_conf_dir }}/{{ awg_server_iface }}.iface"
PRIV = "{{ awg_server_conf_dir }}/{{ awg_server_iface }}_priv"
WG = "/etc/wireguard/{{ awg_server_wg_iface }}.conf"
WG_NET = ipaddress.ip_network("{{ awg_server_wg_network }}")
AWG_NET = ipaddress.ip_network("{{ awg_server_network }}")
OBFUSCATION_KEYS = ("Jc", "Jmin", "Jmax", "S1", "S2", "H1", "H2", "H3", "H4")


def mirror(value):
    """AmneziaWG address for a wg0 pool address; anything else unchanged."""
    try:
        net = ipaddress.ip_network(value, strict=False)
    except ValueError:
        return value
    if net.version == 4 and net.prefixlen == 32 and net.network_address in WG_NET:
        offset = int(net.network_address) - int(WG_NET.network_address)
        return f"{AWG_NET.network_address + offset}/32"
    return value


def active_peers(text):
    peers, current, active = [], None, False
    for raw in text.splitlines():
        line = raw.strip()
        if re.sub(r"^#\s*", "", line) == "[Peer]":
            if current is not None and active:
                peers.append(current)
            current, active = {}, not line.startswith("#")
            continue
        if current is None or not active or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "AllowedIPs":
            value = ", ".join(mirror(ip.strip()) for ip in value.split(",") if ip.strip())
        if key in ("PublicKey", "PresharedKey", "AllowedIPs"):
            current[key] = value
    if current is not None and active:
        peers.append(current)
    return [p for p in peers if p.get("PublicKey") and p.get("AllowedIPs")]


def render():
    iface = open(IFACE_SRC).read().rstrip().splitlines()
    key = open(PRIV).read().strip()
    out = []
    for line in iface:
        out.append(line)
        if line.strip() == "[Interface]":
            out.append(f"PrivateKey = {key}")
    wg_text = open(WG).read() if os.path.exists(WG) else ""
    peers = active_peers(wg_text)
    for peer in peers:
        out.append("")
        out.append("[Peer]")
        out.extend(f"{k} = {peer[k]}" for k in ("PublicKey", "PresharedKey", "AllowedIPs") if k in peer)
    return "\n".join(out) + "\n", len(peers)


def live_obfuscation(show_output):
    """Obfuscation values from `awg show <iface>` output, keyed like obfuscation.json."""
    names = {key.lower(): key for key in OBFUSCATION_KEYS}
    values = {}
    for line in show_output.splitlines():
        name, sep, value = line.strip().partition(":")
        if sep and name.strip().lower() in names:
            values[names[name.strip().lower()]] = value.strip()
    return values


def check_obfuscation(path):
    with open(path, encoding="utf-8") as handle:
        expected = json.load(handle)
    shown = subprocess.run(["awg", "show", IFACE], capture_output=True, text=True)
    if shown.returncode != 0:
        print(f"{IFACE} is not running; nothing to compare")
        return 0
    live = live_obfuscation(shown.stdout)
    drift = {
        key: (live[key], str(expected[key]))
        for key in OBFUSCATION_KEYS
        if key in live and key in expected and live[key] != str(expected[key])
    }
    if drift:
        details = ", ".join(f"{k}: running {a}, file {b}" for k, (a, b) in sorted(drift.items()))
        print(f"{IFACE} runs with other obfuscation parameters than {path} ({details}). Every issued "
              "AmneziaWG config carries the running values: restore the file from a backup instead "
              "of applying new ones.", file=sys.stderr)
        return 3
    print(f"{IFACE}: obfuscation matches {path}")
    return 0


def main(argv):
    if argv[:1] == ["--check-obfuscation"] and len(argv) == 2:
        return check_obfuscation(argv[1])
    content, count = render()
    current = open(CONF).read() if os.path.exists(CONF) else None
    if content != current:
        tmp = CONF + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(content)
        os.replace(tmp, CONF)
    if "--no-apply" in argv:
        return 0
    if subprocess.run(["ip", "link", "show", IFACE], capture_output=True).returncode != 0:
        return 0  # not up yet: awg-quick reads the file when it starts
    strip = subprocess.run(["awg-quick", "strip", IFACE], capture_output=True, text=True, check=True).stdout
    subprocess.run(["awg", "syncconf", IFACE, "/dev/stdin"], input=strip, text=True, check=True)
    print(f"{IFACE}: {count} peers")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
