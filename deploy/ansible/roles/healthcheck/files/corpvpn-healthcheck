#!/usr/bin/env python3
"""CorpVPN gateway health check (installed as /usr/local/sbin/corpvpn-healthcheck,
run every few minutes by corpvpn-healthcheck.timer).

Checks what clients depend on: the panel, the tunnels and their ports, IPv4
forwarding, CorpVPN's nftables tables, the REALITY key the panel hands out, the
AmneziaWG obfuscation, the panel certificate and the age of the last backup.
Tables that vanished (e.g. `nft flush ruleset`, or nftables.service reloaded
with a stock config) are loaded again by restarting the unit that owns them.

Exit 0 when everything passes, 1 otherwise; each result goes to the journal,
failures also to the optional alert command (the summary on its stdin), and to
node_exporter's textfile directory when it exists.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.request


def sh(*argv: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(list(argv), capture_output=True, text=True, input=stdin, timeout=60)


class Checks:
    def __init__(self, settings: dict):
        self.settings = settings
        self.results: list[tuple[str, bool, str]] = []

    def record(self, name: str, ok: bool, detail: str = "") -> None:
        self.results.append((name, ok, detail))

    def unit(self, name: str) -> None:
        state = sh("systemctl", "is-active", name).stdout.strip()
        self.record(f"unit {name}", state == "active", state)

    def panel(self) -> None:
        url = self.settings.get("panel_health_url")
        if not url:
            return
        try:
            with urllib.request.urlopen(url, timeout=10) as response:
                status = json.load(response).get("status")
            self.record("panel /health", status == "ok", f"status {status}")
        except (OSError, ValueError) as exc:
            self.record("panel /health", False, str(exc))

    def interfaces(self) -> None:
        for iface in self.settings.get("interfaces", []):
            up = sh("ip", "link", "show", iface["name"]).returncode == 0
            listening = sh("ss", "-Hlun", f"sport = :{iface['port']}").stdout.strip() != ""
            self.record(f"interface {iface['name']}", up and listening,
                        "" if up and listening else f"up={up} udp/{iface['port']} listening={listening}")

    def tcp_ports(self) -> None:
        for port in self.settings.get("tcp_ports", []):
            listening = sh("ss", "-Hltn", f"sport = :{port}").stdout.strip() != ""
            self.record(f"tcp/{port} listening", listening)

    def forwarding(self) -> None:
        value = sh("sysctl", "-n", "net.ipv4.ip_forward").stdout.strip()
        if value != "1":
            sh("sysctl", "-q", "-w", "net.ipv4.ip_forward=1")
        self.record("ipv4 forwarding", value == "1", "" if value == "1" else "was off; switched on")

    def tables(self) -> None:
        for table, unit in sorted(self.settings.get("tables", {}).items()):
            if sh("nft", "list", "table", "inet", table).returncode == 0:
                self.record(f"nft table {table}", True)
                continue
            sh("systemctl", "restart", unit)
            restored = sh("nft", "list", "table", "inet", table).returncode == 0
            self.record(f"nft table {table}", False,
                        f"was missing; {unit} restarted, {'restored' if restored else 'still missing'}")

    def reality(self) -> None:
        reality = self.settings.get("reality")
        if not reality:
            return
        result = sh(reality["tool"], "check", "--config", reality["config"], "--env", reality["env"],
                    "--tag", reality["tag"])
        self.record("REALITY key in client links", result.returncode == 0,
                    (result.stderr or result.stdout).strip()[-400:] if result.returncode else "")

    def amneziawg(self) -> None:
        awg = self.settings.get("awg")
        if not awg:
            return
        result = sh(awg["tool"], "--check-obfuscation", awg["obfuscation"])
        self.record("AmneziaWG obfuscation", result.returncode == 0,
                    (result.stderr or result.stdout).strip()[-400:] if result.returncode else "")

    def certificate(self) -> None:
        cert = self.settings.get("certificate")
        if not cert:
            return
        days = int(self.settings.get("certificate_min_days", 14))
        if not os.path.exists(cert):
            self.record("panel certificate", False, f"{cert} missing")
            return
        ok = sh("openssl", "x509", "-in", cert, "-noout", "-checkend", str(days * 86400)).returncode == 0
        self.record("panel certificate", ok, "" if ok else f"expires within {days} days")

    def backup(self) -> None:
        state_file = self.settings.get("backup_state")
        if not state_file:
            return
        max_age = float(self.settings.get("backup_max_age_hours", 26)) * 3600
        try:
            with open(state_file, encoding="utf-8") as handle:
                state = json.load(handle)
        except (OSError, ValueError):
            self.record("backup", False, "no successful backup recorded yet")
            return
        age = time.time() - float(state.get("last_success", 0))
        ok = age <= max_age
        self.record("backup", ok, "" if ok else
                    f"last good backup {age / 3600:.0f} h ago; last error: {state.get('last_error') or '-'}")

    def run(self) -> None:
        for unit in self.settings.get("units", []):
            self.unit(unit)
        self.panel()
        self.interfaces()
        self.tcp_ports()
        self.forwarding()
        self.tables()
        self.reality()
        self.amneziawg()
        self.certificate()
        self.backup()


def write_metrics(directory: str, results: list[tuple[str, bool, str]]) -> None:
    if not directory or not os.path.isdir(directory):
        return
    failed = sum(1 for _, ok, _ in results if not ok)
    lines = [
        "# HELP corpvpn_healthcheck_failed_checks Checks that failed in the last run.",
        "# TYPE corpvpn_healthcheck_failed_checks gauge",
        f"corpvpn_healthcheck_failed_checks {failed}",
        "# HELP corpvpn_healthcheck_last_run_timestamp_seconds Time of the last run.",
        "# TYPE corpvpn_healthcheck_last_run_timestamp_seconds gauge",
        f"corpvpn_healthcheck_last_run_timestamp_seconds {int(time.time())}",
        "# HELP corpvpn_healthcheck_ok 1 when the check passed.",
        "# TYPE corpvpn_healthcheck_ok gauge",
    ]
    for name, ok, _ in results:
        label = name.replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'corpvpn_healthcheck_ok{{check="{label}"}} {1 if ok else 0}')
    target = os.path.join(directory, "corpvpn_health.prom")
    with open(target + ".tmp", "w", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")
    os.replace(target + ".tmp", target)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="CorpVPN gateway health check")
    parser.add_argument("--config", default="/etc/vpn-panel/healthcheck.json")
    args = parser.parse_args(argv)
    with open(args.config, encoding="utf-8") as handle:
        settings = json.load(handle)
    checks = Checks(settings)
    checks.run()
    failures = [f"{name}: {detail}" if detail else name for name, ok, detail in checks.results if not ok]
    for name, ok, detail in checks.results:
        print(f"{'OK  ' if ok else 'FAIL'} {name}{': ' + detail if detail else ''}")
    write_metrics(settings.get("textfile_dir", ""), checks.results)
    if failures and settings.get("alert_command"):
        summary = "CorpVPN health check on %s failed:\n%s\n" % (os.uname().nodename, "\n".join(failures))
        sh("/bin/sh", "-c", settings["alert_command"], stdin=summary)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
