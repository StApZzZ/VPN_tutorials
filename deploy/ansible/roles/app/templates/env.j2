{#- q(): a double-quoted value, read the same way by systemd EnvironmentFile and
    python-dotenv. Used for secrets and free text (spaces, '#', quotes, '$').
    The macro comes before any output line: with Ansible's trim_blocks the
    whitespace control around it must not glue two lines together. -#}
{% macro q(value) -%}
"{{ (value | default('') | string).replace('\\', '\\\\').replace('"', '\\"') }}"
{%- endmacro %}
{% set awg = 'awg' in vpn_panel_enabled_protocols %}
