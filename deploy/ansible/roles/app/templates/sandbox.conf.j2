# Sandbox: root only to manage wg / awg / nft (CAP_NET_ADMIN) and to restart
# Xray; it may write its own state and the files it manages, nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths={{ vpn_panel_config_dir }} /etc/wireguard {{ vpn_panel_nft_policy_dir }} {{ vpn_panel_backup_dir }} -{{ vpn_panel_xray_config_dir }} -{{ awg_server_conf_dir }}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
