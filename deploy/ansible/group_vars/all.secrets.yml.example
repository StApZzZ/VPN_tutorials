# Copy to deploy/ansible/group_vars/all.secrets.yml (gitignored) and fill real values.
# quickstart.sh generates this file for you.

# Break-glass admin token for the panel (login password and API Bearer token).
# Generate with: openssl rand -base64 32
panel_secret_token: replace-with-long-random-token

# OIDC client secret (confidential client) and the LDAP service account password.
vpn_panel_oidc_client_secret: ""
vpn_panel_ldap_bind_password: ""
