# ==============================================================
# VPN Panel — Quickstart Configuration
# ==============================================================
# 1. Copy this file:
#      cp deploy/quickstart.env.example deploy/quickstart.env
# 2. Fill in every required field below.
# 3. Run:
#      ./deploy/quickstart.sh           (Linux / macOS / WSL)
#      .\deploy\quickstart.ps1          (Windows PowerShell)
# ==============================================================

# --------------------------------------------------------------
# SERVER A — Primary node (panel + VPN ingress)
# Required.
# --------------------------------------------------------------
SERVER_A_IP=203.0.113.10

# If you have a domain name pointing to Server A, set it here.
# Client configs will use this hostname instead of the IP.
# Leave empty to use SERVER_A_IP directly.
SERVER_A_DOMAIN=

# --------------------------------------------------------------
# SERVER B — Relay/egress node (optional)
# Leave SERVER_B_IP empty for single-server mode.
# Server B only needs a clean systemd-based Debian-like or
# Oracle/RHEL-like install and SSH access.
# --------------------------------------------------------------
SERVER_B_IP=
SERVER_B_DOMAIN=

# --------------------------------------------------------------
# SSH Access
# Both servers must be reachable with the same key by default.
# Set SERVER_B_SSH_KEY to use a different key for Server B.
# --------------------------------------------------------------
SSH_KEY=~/.ssh/id_ed25519
SSH_USER=root
SERVER_B_SSH_KEY=

# --------------------------------------------------------------
# Panel Authentication Token
# Generate with:  openssl rand -base64 32
# Required.
# --------------------------------------------------------------
PANEL_SECRET_TOKEN=replace-with-long-random-token

# --------------------------------------------------------------
# Telegram Bot (optional)
# Leave all three empty to skip bot deployment entirely.
# The panel works fully without the bot.
# In a two-server setup quickstart probes Telegram reachability and
# deploys the bot on Server B. If Server B cannot reach Telegram,
# quickstart stops instead of placing the bot on Server A.
# --------------------------------------------------------------

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user IDs of admins, comma-separated (no spaces)
# Find your ID with @userinfobot
TELEGRAM_ADMIN_IDS=

# Bot username from @BotFather (without the @)
TELEGRAM_BOT_USERNAME=

# --------------------------------------------------------------
# Xray / REALITY transport
# REALITY_SERVER_NAME must be a domain that supports TLS 1.3 + H2.
# Common choices: www.microsoft.com, www.apple.com, www.amazon.com
# quickstart bootstraps curl, ca-certificates, and openssl on the
# remote hosts before installing Xray.
# --------------------------------------------------------------
REALITY_SERVER_NAME=www.microsoft.com

# REALITY keys for Server A.
# Leave all three empty — the quickstart will generate them for you.
SERVER_A_REALITY_PRIVATE_KEY=
SERVER_A_REALITY_PUBLIC_KEY=
SERVER_A_REALITY_SHORT_ID=

# REALITY keys for Server B (only used if SERVER_B_IP is set).
# Leave all three empty — the quickstart will generate them for you.
SERVER_B_REALITY_PRIVATE_KEY=
SERVER_B_REALITY_PUBLIC_KEY=
SERVER_B_REALITY_SHORT_ID=
