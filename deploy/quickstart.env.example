# ==============================================================
# CorpVPN — quickstart configuration
# ==============================================================
# 1. cp deploy/quickstart.env.example deploy/quickstart.env
# 2. Fill in the required fields (marked REQUIRED); everything else has a default.
# 3. Run from Linux, macOS or WSL:   ./deploy/quickstart.sh
#    (Windows: .\deploy\quickstart.ps1 hands over to WSL.)
#
# This file contains KEY=VALUE data; shell commands are never executed: quote values that contain spaces,
#   e.g. CORP_CIDRS='10.0.0.0/8, 192.168.10.0/24'
# Re-running quickstart is safe: server keys, peers, AmneziaWG parameters and
# REALITY keys already on the servers are kept. Guide: QUICKSTART.md
# ==============================================================

# --------------------------------------------------------------
# Server A — the gateway (VPN + panel). Ubuntu 22.04/24.04 or Debian 12/13; root or passwordless sudo.
# --------------------------------------------------------------
SERVER_A_IP=203.0.113.10                 # REQUIRED
# DNS name of Server A. With CERTBOT_EMAIL it gets a Let's Encrypt certificate;
# clients dial the name instead of the IP.
PANEL_FQDN=
CERTBOT_EMAIL=
# auto (default): letsencrypt when PANEL_FQDN + CERTBOT_EMAIL are set, otherwise a
# self-signed certificate. none: plain HTTP (only behind your own TLS proxy).
TLS_MODE=auto

SSH_KEY=~/.ssh/id_ed25519                # REQUIRED
SSH_USER=root

# --------------------------------------------------------------
# Protocols: any of wg, awg, vless.
#   wg    WireGuard (UDP 51820)
#   awg   AmneziaWG — WireGuard with obfuscation (UDP 51821), built from source
#   vless VLESS + REALITY through Xray (TCP 443) for networks that block UDP
# --------------------------------------------------------------
PROTOCOLS=wg,awg,vless
# Component versions and checksums are pinned in deploy/versions.yml.
REALITY_SERVER_NAME=www.cloudflare.com

# --------------------------------------------------------------
# Corporate network
# --------------------------------------------------------------
# Every corporate range. Access profiles decide who reaches which of them;
# anything listed here that a profile does not allow is blocked.
CORP_CIDRS=
# Resolver(s) handed to VPN clients (internal DNS). Empty = 1.1.1.1, 1.0.0.1.
CORP_DNS=

# Split mode: Server B sits inside the office network and connects out to
# Server A over WireGuard; CORP_CIDRS are routed through it. Leave empty when
# Server A itself can reach the corporate network (single mode).
# Your machine must reach Server B over SSH (directly, VPN or jump host).
SERVER_B_IP=
SERVER_B_SSH_KEY=

# --------------------------------------------------------------
# Sign-in: local | oidc | ldap
# A break-glass admin (user "admin" + PANEL_SECRET_TOKEN) always exists.
# Group lists are comma-separated exact names or qualified group paths / AD DNs.
# --------------------------------------------------------------
AUTH_MODE=local
AUTH_ADMIN_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_USER_GROUPS=

# OIDC — Keycloak, ADFS 2016+, Entra ID (docs/IDP-KEYCLOAK.md, docs/IDP-ADFS.md).
# Redirect URI to register: https://<PANEL_FQDN or IP>/auth/oidc/callback
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_LABEL=

# LDAP / Active Directory (docs/IDP-AD-LDAP.md). Use ldaps:// or LDAP_START_TLS=true.
LDAP_URL=
LDAP_START_TLS=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
# Local path to the CA certificate that signed the domain controllers' certificates.
LDAP_CA_FILE=

# --------------------------------------------------------------
# Break-glass token. Empty = generated, stored in
# deploy/ansible/group_vars/all.secrets.yml with mode 0600. Read the protected file to obtain it.
# --------------------------------------------------------------
PANEL_SECRET_TOKEN=

# REALITY keys for Server A. Leave empty: generated on the first run, reused later.
SERVER_A_REALITY_PRIVATE_KEY=
SERVER_A_REALITY_PUBLIC_KEY=
SERVER_A_REALITY_SHORT_ID=

# Local accounts require TOTP for administrators by default: off | admins | all.
AUTH_LOCAL_TOTP=admins
AUTH_LOCAL_ALLOWED_CIDRS=
# For TLS_MODE=none, both are mandatory. Restrict the gateway's HTTP listener to
# your TLS proxy; use its externally visible HTTPS origin for cookies and OIDC.
TRUSTED_PROXY_CIDRS=
PANEL_PUBLIC_URL=
# Custom certificate files on the controller (TLS_MODE=custom).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Equal-size non-overlapping IPv4 pools; cannot change with existing peers.
WG_NETWORK=10.66.0.0/22
AWG_NETWORK=10.66.4.0/22
WG_PORT=51820
AWG_PORT=51821
# Optional directory schema overrides (defaults target Active Directory).
LDAP_USER_FILTER=
LDAP_USERNAME_ATTR=
LDAP_DISPLAY_NAME_ATTR=
LDAP_GROUP_BASE_DN=
LDAP_GROUP_SEARCH_FILTER=
LDAP_GROUP_ATTR=
LDAP_DISABLED_FILTER=
OIDC_ENABLED=false
LDAP_ENABLED=false
OIDC_GROUPS_CLAIMS=
OIDC_USERNAME_CLAIMS=

# Connector LAN interface (empty = default-route interface) and split DNS suffixes.
SITE_LAN_INTERFACE=
CORP_DOMAINS=

# Isolated acceptance lab only; production providers must use HTTPS.
OIDC_ALLOW_INSECURE_HTTP=false
